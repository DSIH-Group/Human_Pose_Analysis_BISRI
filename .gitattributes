# Normalize line endings for all text files to LF in the repo,
# and let Git handle conversion on checkout based on the OS.
* text=auto eol=lf

# Explicitly treat notebooks as text so diffs/line-ending rules apply
*.ipynb text eol=lf

# Explicitly mark binary/non-text files so Git never tries to convert them
*.png binary
*.jpg binary
*.jpeg binary
*.svg text eol=lf
*.pkl binary
